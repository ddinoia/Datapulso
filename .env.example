# Copiar a .env y ajustar. Nunca commitear .env.
DP_PG_HOST=127.0.0.1
DP_PG_PORT=55432
DP_DB_NAME=datapulso
DP_ADMIN_USER=postgres          # rol que migra y crea tenants (dueño del esquema)
DP_ADMIN_PASSWORD=
DP_APP_USER=datapulso_app       # rol de la aplicación: sin BYPASSRLS, sin ser dueño de las tablas
DP_APP_PASSWORD=cambiar-en-cada-entorno
# Clave Fernet para cifrar credenciales de fuentes. Generar con:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DATAPULSO_SECRET_KEY=
